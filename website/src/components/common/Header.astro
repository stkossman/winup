---
import { Github, Package } from "lucide-astro";

const navLinks = [
	{ label: "Usage", href: "#usage" },
	{ label: "Install", href: "#install" },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-base)]/90 backdrop-blur-sm">
  <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">

    <span class="font-mono font-bold text-[var(--color-accent)] text-lg tracking-tight">
      winup
    </span>

    <nav class="flex items-center gap-6">
      <span class="font-mono text-xs text-[var(--color-muted)]">v1.0.1</span>

      {navLinks.map(link => (
        <a>
          href={link.href}
          class="font-mono text-xs text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors"
        >
          {link.label}
        </a>
      ))}

      
        href="https://www.npmjs.com/package/winup-cli"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-xs flex items-center gap-1.5 text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors"
      >
        <Package size={14} />
        npm
      </a>

      
        href="https://github.com/stkossman/winup"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-xs flex items-center gap-1.5 border border-[var(--color-border)] text-[var(--color-primary)] px-3 py-1.5 rounded hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-all"
      >
        <Github size={14} />
        GitHub
      </a>
    </nav>

  </div>
</header>