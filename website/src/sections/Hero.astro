---
import { Download, Package } from "lucide-astro";
---

<section class="max-w-6xl mx-auto px-6 pt-24 pb-20 border-b border-[var(--color-border)]">

  <p class="font-mono text-xs text-[var(--color-muted)] tracking-[var(--tracking-widest)] uppercase mb-8">
    Windows package manager wrapper
  </p>

  <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-12">

    <h1 class="text-[clamp(3rem,9vw,7rem)] leading-[var(--leading-tight)] text-[var(--color-primary)] max-w-2xl">
      Winget upgrades,<br />
      <span class="text-[var(--color-accent)]">finally</span><br />
      bearable.
    </h1>

    <div class="font-mono text-sm bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl overflow-hidden w-full lg:w-80 shrink-0">
        <div class="flex items-center gap-2 px-4 py-3 border-b border-[var(--color-border)] bg-[var(--color-surface-2)]">
            <span class="w-3 h-3 rounded-full bg-red-400"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
            <span class="w-3 h-3 rounded-full bg-green-400"></span>
            <span class="ml-2 text-[var(--color-muted)] text-xs">Terminal</span>
        </div>
        <div class="px-4 py-4 space-y-1 text-xs text-[var(--color-secondary)]">
            <p><span class="text-[var(--color-muted)]">~</span> <span class="text-[var(--color-accent)]">winup check</span></p>
            <p class="pl-2 text-[var(--color-muted)]">[ INFO ] Checking for available updates...</p>
            <p class="pl-2"><span class="text-green-600">[ OK ]</span> Found 32 upgrades (Safe: 31, Unknown: 1).</p>
            <p class="pl-2 text-[var(--color-muted)]">[ INFO ] Use 'winup list' to view them.</p>

            <p class="pt-3"><span class="text-[var(--color-muted)]">~</span> <span class="text-[var(--color-accent)]">winup upgrade</span></p>
            <p class="pl-2 text-[var(--color-muted)]">[ INFO ] Fetching available upgrades...</p>
            <p class="pl-2 pt-1">? Select packages to upgrade:</p>
            <p class="pl-2"><span class="text-[var(--color-accent)]">◉</span> Obsidian.Obsidian</p>
            <p class="pl-2"><span class="text-[var(--color-accent)]">◉</span> Python.Python.3.13</p>
            <p class="pl-2"><span class="text-[var(--color-accent)]">◉</span> ZedIndustries.Zed</p>
            <p class="pl-2"><span class="text-[var(--color-muted)]">○</span> Microsoft.PowerShell</p>
            <p class="pl-2"><span class="text-[var(--color-muted)]">○</span> AutoHotkey.AutoHotkey</p>

            <p class="pt-2">
            <span class="text-[var(--color-muted)]">~</span>
            <span class="animate-blink ml-0.5">▋</span>
            </p>
        </div>
    </div>

  </div>

  <p class="mt-10 text-lg text-[var(--color-secondary)] max-w-xl leading-[var(--leading-relaxed)]">
    A fast, interactive wrapper around <code>winget</code> — hides noisy unknown
    versions, lets you pick exactly what to upgrade, ships as a standalone <code>.exe</code>.
  </p>

  <div class="mt-8 flex flex-wrap gap-4">
    
      href="https://github.com/stkossman/winup/releases"
      class="font-mono text-sm inline-flex items-center gap-2 bg-[var(--color-accent)] text-[var(--color-accent-text)] font-bold px-6 py-3 rounded-lg hover:bg-[var(--color-accent-hover)] transition-colors"
    >
      <Download size={16} />
      Download .exe
    </a>
    
      href="#install"
      class="font-mono text-sm inline-flex items-center gap-2 border border-[var(--color-border)] text-[var(--color-primary)] px-6 py-3 rounded-lg hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-all"
    >
      <Package size={16} />
      npm install
    </a>
  </div>

</section>