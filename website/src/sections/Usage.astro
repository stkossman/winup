---
const commands = [
	{
		cmd: "winup check",
		description:
			"Quickly see how many updates are available without parsing the full list.",
		output: [
			{ text: "[ INFO ] Checking for available updates...", type: "info" },
			{ text: "[ OK ] 32 upgrades available.", type: "ok" },
		],
	},
	{
		cmd: "winup list",
		description:
			"Display a clean table of all safe updates. Add --include-unknown to show everything.",
		output: [
			{ text: "[ INFO ] Fetching available upgrades...", type: "info" },
			{
				text: "--------------------------------------------------------------------------------",
				type: "muted",
			},
			{
				text: "Name                  Id                          Version        Available",
				type: "plain",
			},
			{
				text: "--------------------------------------------------------------------------------",
				type: "muted",
			},
			{
				text: "Obsidian              Obsidian.Obsidian           1.7.7          1.12.7   ",
				type: "ok",
			},
			{
				text: "Python 3.13           Python.Python.3.13          3.13.7         3.13.13  ",
				type: "ok",
			},
			{
				text: "Zed                   ZedIndustries.Zed           1.0.1          1.2.6    ",
				type: "ok",
			},
			{
				text: "AutoHotkey            AutoHotkey.AutoHotkey       2.0.19         2.0.26   ",
				type: "ok",
			},
		],
	},
	{
		cmd: "winup upgrade",
		description:
			"Launch the interactive checkbox prompt. Safe packages are selected by default.",
		output: [
			{ text: "[ INFO ] Fetching available upgrades...", type: "info" },
			{
				text: "? Select packages to upgrade (Space to select, Enter to confirm):",
				type: "plain",
			},
			{
				text: "❯ ◉ Obsidian (Obsidian.Obsidian) [1.7.7 -> 1.12.7]",
				type: "info",
			},
			{
				text: "  ◉ Python (Python.Python.3.13) [3.13.7 -> 3.13.13]",
				type: "info",
			},
			{
				text: "  ◯ Telegram (Telegram.Telegram) [unknown -> unknown] (UNKNOWN)",
				type: "warn",
			},
		],
	},
	{
		cmd: "winup upgrade --all-safe",
		description:
			"Skip the prompt entirely. Automatically upgrades all packages with known versions.",
		output: [
			{ text: "[ INFO ] Fetching available upgrades...", type: "info" },
			{ text: "[ INFO ] Starting upgrade for 3 package(s)...", type: "info" },
			{ text: "", type: "plain" },
			{
				text: "[ INFO ] Upgrading Obsidian (Obsidian.Obsidian)...",
				type: "info",
			},
			{ text: "[ OK ] Obsidian.Obsidian successfully upgraded.", type: "ok" },
			{ text: "", type: "plain" },
			{
				text: "[ OK ] All selected packages upgraded successfully.",
				type: "ok",
			},
		],
	},
	{
		cmd: "winup upgrade --dry-run",
		description:
			"Simulate the entire upgrade process without making any real changes to your system.",
		output: [
			{ text: "[ INFO ] Fetching available upgrades...", type: "info" },
			{ text: "[ INFO ] Starting upgrade for 1 package(s)...", type: "info" },
			{ text: "", type: "plain" },
			{
				text: "[ INFO ] Upgrading Obsidian (Obsidian.Obsidian)...",
				type: "info",
			},
			{
				text: "[ OK ] Obsidian.Obsidian successfully upgraded (DRY RUN).",
				type: "ok",
			},
		],
	},
	{
		cmd: "winup upgrade -i Obsidian.Obsidian",
		description:
			"Upgrade specific packages by ID - like winget, but with safety checks built in.",
		output: [
			{ text: "[ INFO ] Fetching available upgrades...", type: "info" },
			{ text: "[ INFO ] Starting upgrade for 1 package(s)...", type: "info" },
			{ text: "", type: "plain" },
			{
				text: "[ INFO ] Upgrading Obsidian (Obsidian.Obsidian)...",
				type: "info",
			},
			{ text: "[ OK ] Obsidian.Obsidian successfully upgraded.", type: "ok" },
			{ text: "", type: "plain" },
			{
				text: "[ OK ] All selected packages upgraded successfully.",
				type: "ok",
			},
		],
	},
];
---

<section id="usage" class="max-w-6xl mx-auto px-6 py-20 border-b border-[var(--color-border)]">

  <p class="font-mono text-xs text-[var(--color-muted)] tracking-[var(--tracking-widest)] uppercase mb-4">
    Usage
  </p>
  <h2 class="text-4xl lg:text-5xl text-[var(--color-primary)] mb-14 max-w-xl">
    Every command,<br />explained.
  </h2>

  <div class="flex flex-col gap-0 divide-y divide-[var(--color-border)]">
    {commands.map(({ cmd, description, output }) => (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 py-10">

        <div class="flex flex-col gap-3">
          <p class="font-mono text-[var(--color-accent)]">$ {cmd}</p>
          <p class="text-sm text-[var(--color-secondary)] leading-[var(--leading-relaxed)] pl-4 border-l border-[var(--color-border)]">
            {description}
          </p>
        </div>

        <div class="font-mono text-xs bg-[var(--color-surface)] border border-[var(--color-border)] rounded-lg overflow-hidden">
          <div class="flex items-center gap-2 px-4 py-2.5 border-b border-[var(--color-border)] bg-[var(--color-surface-2)]">
            <span class="w-2.5 h-2.5 rounded-full bg-red-400"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-green-400"></span>
            <span class="ml-2 text-[var(--color-muted)] text-xs">{cmd}</span>
          </div>
          <div class="px-4 py-3 space-y-1">
            <p><span class="text-[var(--color-muted)]">~</span> <span class="text-[var(--color-accent)]">{cmd}</span></p>
            {output.map(line => (
              <p class:list={[
                'pl-2 whitespace-pre',
                line.type === 'info' && 'text-cyan-400',
                line.type === 'ok' && 'text-green-400',
                line.type === 'warn' && 'text-yellow-400',
                line.type === 'muted' && 'text-[var(--color-muted)]',
                line.type === 'plain' && 'text-[var(--color-secondary)]',
              ]}>
                {line.text === "" ? " " : line.text}
              </p>
            ))}
          </div>
        </div>

      </div>
    ))}
  </div>

</section>