{
	"name": "winup-cli",
	"version": "1.0.1",
	"description": "Minimalistic winget upgrade manager",
	"main": "dist/cli/index.js",
	"type": "module",
	"bin": {
		"winup": "./bin/cli.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"scripts": {
		"build": "tsc",
		"start": "node ./bin/cli.js",
		"test": "vitest run",
		"dev": "vitest",
		"compile:exe": "bun build ./src/cli/index.ts --compile --minify --target=bun-windows-x64 --outfile=winup.exe"
	},
	"keywords": [
		"winget",
		"windows",
		"cli",
		"upgrade",
		"updater",
		"package-manager"
	],
	"author": "stkossman (https://github.com/stkossman)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/stkossman/winup.git"
	},
	"dependencies": {
		"@inquirer/checkbox": "^5.1.5",
		"commander": "^14.0.3",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@types/node": "^25.8.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.6"
	}
}
