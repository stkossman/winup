{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"],
		"typeRoots": ["./node_modules/@types", "./node_modules"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "tests", "dist"]
}
